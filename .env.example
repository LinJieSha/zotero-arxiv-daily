# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，切勿提交。

# --- Zotero --- https://www.zotero.org/settings/security
# User ID 是纯数字，不是用户名
ZOTERO_ID=
# API key 需勾选 read access
ZOTERO_KEY=

# --- 邮件 --- QQ 邮箱设置 → 账户 → 开启 SMTP → 生成授权码
SENDER=
RECEIVER=
# 是 SMTP 授权码，不是 QQ 登录密码
SENDER_PASSWORD=

# --- LLM --- https://platform.deepseek.com/
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com
